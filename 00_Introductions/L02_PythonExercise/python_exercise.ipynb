    "# 02 . FIBONACCI SEQUENCE_TRIANGLE\n",
    "\n",
    "from itertools import pairwise\n",
    "\n",
    "# VARIABLES\n",
    "first_tuple = [10, 10]\n",
    "total = 50\n",
    "limit = 10000\n",
    "lines = 20\n",
    "\n",
    "# FUNCTION DEFINITION\n",
    "\n",
    "def fibonacci_sequence(first_tuple, total, limit):\n",
    "    # SAVE THE FIRST TWO NUMBERS\n",
    "    seq = [first_tuple[0], first_tuple[1]]\n",
    "\n",
    "    # SAVE THE MIDDLE NUMBERS UNTIL THE TOTAL OR THE LIMIT NUMBER IS REACHED\n",
    "    while len(seq) < total:\n",
    "        next_number = seq[-1] + seq [-2]\n",
    "\n",
    "        if next_number > limit:\n",
    "            break\n",
    "        seq.append(next_number)\n",
    "            \n",
    "    return seq\n",
    "\n",
    "def fibonacci_triangle(lines, first_tuple, limit):\n",
    "\n",
    "    # 1 . GENERATE THE MASTER SEQUENCE OF NUMBERS\n",
    "    master_seq = fibonacci_sequence(first_tuple, total, limit)\n",
    "\n",
    "    # 2 . BUILD EACH ROW --- 1 ITEM --- 2 ITEMS --- 3 ITEMS\n",
    "    # START WITH I=0\n",
    "    index = 0\n",
    "    for row_length in (range(1, lines+1)):\n",
    "        row = master_seq[index : index + row_length]\n",
    "\n",
    "        if not row:\n",
    "            break\n",
    "        print (\" \" * (lines - len(row)), *row)\n",
    "\n",
    "        index += row_length\n",
    "\n",
    "# CALL AND PRINT\n",
    "fibonacci_triangle(lines, first_tuple, limit)"
   ]

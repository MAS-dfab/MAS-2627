    "#Revision of concepts Part 02 18/09/2026\n",
    "\n",
    "first_name = \"Vruti\" #Note that python reads this as [\"V\",\"r\",\"u\",\"t\",\"i\"]\n",
    "last_name = \"Vora\"\n",
    "\n",
    "print(\"her name\") #This command will print the string\n",
    "print(\" \") #will add space between lines\n",
    "print(first_name) #will print the defined first name\n",
    "print(last_name) #will print the defined last name\n",
    "print(\" \") #will print space between lines\n",
    "print(\"spell out her name\") #will print the string\n",
    "print(\" \") #will print space betweeb lines\n",
    "for i in (first_name): #will print characters line by line in first name\n",
    "    print(i)\n",
    "print(\" \") #will print space between lines\n",
    "for i in (last_name): #will print characters line by line in last name\n",
    "    print(i) \n",
    "print(\" \") #will print space between lines\n",
    "print(\"pronounce her name\") #will print the string\n",
    "print(\" \") #will print space between lines\n",

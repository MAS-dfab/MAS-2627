    "from itertools import pairwise\n",
    "\n",
    "# recursive version of the next_pascal_row function\n",
    "def pascal(n):\n",
    "    if n == 0:\n",
    "        return [1]\n",
    "\n",
    "    previous = pascal(n - 1)\n",
    "    print (previous)\n",
    "\n",
    "    return [1] + [a + b for a, b in pairwise(previous)] + [1]\n",
    "\n",
    "pascal(10)"

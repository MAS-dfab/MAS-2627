   "source": [
    "print(\"enumerate command\") #Enumerate command, lists the items against the list indices\n",
    "print(\" \")\n",
    "\n",
    "a = [15,15,15]\n",
    "\n",
    "for i,j in enumerate(a): #here i will be the llist index number and j will be the listed item at that index\n",
    "    print(i,j)\n",
    "\n",
    "print(\" \")\n",
    "print(\"zip command\") #Zip command gives the corresponding items of 2 lists\n",
    "print(\" \")\n",
    "\n",
    "x = [10,20,30,40]\n",
    "y = [40,50,60]\n",
    "\n",
    "for i,j in zip(x,y): #getting the corresponding items of the lists in this manner you can add the items at same indices for 2 separate lists\n",
    "    print(i+j)"

    "# 03 . COLLATZ CONJECTURE\n",
    "\n",
    "# VARIABLES\n",
    "n = 39\n",
    "\n",
    "# FUNCTION DEFINITION\n",
    "def is_even(n):\n",
    "    return n//2\n",
    "\n",
    "def is_odd(n):\n",
    "    return 3 * n + 1\n",
    "\n",
    "def collatz(n):\n",
    "    # INITIATE THE SEQUENCE\n",
    "    seq = []\n",
    "\n",
    "    # ENTER THE WHILE LOOP\n",
    "    while True:\n",
    "        seq.append(n)\n",
    "\n",
    "        if n == 1:\n",
    "            break\n",
    "        elif n % 2 == 0:\n",
    "            n = is_even(n)\n",
    "        else:\n",
    "            n = is_odd(n)\n",
    "    return seq\n",
    "\n",
    "# CALL AND PRINT\n",
    "collatz_seq = collatz(n)\n",
    "print(*collatz_seq)\n"
   ]

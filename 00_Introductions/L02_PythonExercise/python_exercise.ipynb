    "print(\" \")\n",
    "\n",
    "print(\"reverse her name\") #will print the string\n",
    "print(\" \") #will print space between the lines \n",
    "print(last_name) #will print the last name\n",
    "print(first_name) #will print the first name\n",
    "print(\" \") #will print space between the lines\n",
    "for i in (last_name[::-1]): #will print the characters of the last name in reverse order as per the defined range\n",
    "    print(i)\n",
    "print(\" \")\n",
    "for i in (first_name[::-1]):\n",
    "    print(i)\n"

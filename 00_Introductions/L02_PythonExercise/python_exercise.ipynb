    "# 01 . PASCAL TRIANGLE\n",
    "\n",
    "from itertools import pairwise\n",
    "\n",
    "# VARIABLES\n",
    "base = 20\n",
    "lines = 15\n",
    "\n",
    "# FUNCTION DEFINITION\n",
    "\n",
    "def pascal_triangle(lines, base):\n",
    "    # PRINT THE TIP OF THE TRIANGLE\n",
    "    print (\" \" * lines + str(base))\n",
    "\n",
    "    # PRINT THE MIDDLE NUMBERS\n",
    "    row = [base]\n",
    "    while len(row) < lines:\n",
    "        row = next_row(row, base)\n",
    "        print (\" \" * (lines - len(row)), *row)\n",
    "\n",
    "def next_row(row, base):\n",
    "    new_row = [base]\n",
    "\n",
    "    for a,b in pairwise(row):\n",
    "        new_row.append(a+b)\n",
    "\n",
    "    new_row.append(base)\n",
    "    return new_row\n",
    "\n",
    "# CALL AND PRINT\n",
    "pascal_triangle (lines, base)"
   ]

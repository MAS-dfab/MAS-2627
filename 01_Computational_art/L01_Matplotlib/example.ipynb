    "def draw_shifting_wave(resolution: int, radius: float, freq: float) -> tuple[list[float], list[float], list[float]]:\n",
    "    xs = []\n",
    "    ys = []\n",
    "    ts = []\n",
    "\n",
    "    if radius % 2 == 0:\n",
    "        shift = m.pi\n",
    "    else:\n",
    "        shift = 0\n",
    "\n",
    "    for i in range(resolution):\n",
    "        t = i / (resolution - 1)  # Normalized value between 0 and 1\n",
    "        angle = 2 * m.pi * i / (resolution-1)\n",
    "\n",
    "        r = radius + m.sin(freq * angle + shift) * 0.5 \n",
    "\n",
    "        x = r * m.cos(angle)\n",
    "        y = r * m.sin(angle)\n",
    "        xs.append(x)\n",
    "        ys.append(y)\n",
    "        ts.append(t)\n",
    "    \n",
    "    return xs, ys, ts\n",
    "\n",
    "plt.figure(figsize=(6, 6))\n",
    "\n",
    "xs, ys, ts =draw_shifting_wave(200, 1, 6)\n",
    "\n",
    "plt.plot(xs, ys)\n",
    "\n",
    "plt.show()\n",
    "\n"
   ]

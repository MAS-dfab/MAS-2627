    "# Configuración del dominio\n",
    "theta = np.linspace(0, 2 * np.pi, 1000)  # Usar un número alto de puntos (1000) para suave curva\n",
    "\n",
    "# Parámetros\n",
    "R = 2.0  # Radio del círculo base\n",
    "A = 0.5  # Altura de los pétalos\n",
    "num_petalos = 16  # Número entero para cerrar perfectamente\n",
    "\n",
    "# Radios\n",
    "r_circulo = R\n",
    "r_petalos = R + A * np.abs(np.sin(num_petalos * theta / 2))\n",
    "\n",
    "# Conversión a coordenadas cartesianas (X, Y)\n",
    "x_circulo = r_circulo * np.cos(theta)\n",
    "y_circulo = r_circulo * np.sin(theta)\n",
    "\n",
    "x_petalos = r_petalos * np.cos(theta)\n",
    "y_petalos = r_petalos * np.sin(theta)\n",
    "\n",
    "# Gráfico\n",
    "plt.figure(figsize=(7, 7))\n",
    "plt.plot(x_petalos, y_petalos, label=\"Pétalos\")\n",
    "plt.plot(x_circulo, y_circulo, label=\"Círculo base\")\n",
    "plt.gca().set_aspect(\"equal\")  # Mantiene la proporción circular sin deformación\n",
    "plt.show()"
   ]

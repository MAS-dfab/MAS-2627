// Nano ESP32 — sound, pots and visitor Wi-Fi with a HACK button; sends the slider values to the Nano R4.
//
// Wi-Fi (Stage 7): the ESP32 makes its own open network "DFAB-ESP32" (no hotspot needed).
// Join it with a phone or laptop: the page pops up by itself ("Sign in to network"),
// or open http://192.168.4.1 . Pots, sound and motor run from power-up; they never wait for Wi-Fi.
//
// Wiring (one-way):
//   ESP32 D8 (TX) -> R4 D0 (RX)
//   ESP32 GND     -> R4 GND
//
// Stage 2: the speed (A1) and detune (A2) sliders are sent to the R4 as "S1234 W2048".
//
// Sound on D3 (-> R1 100 ohm -> MOSFET gate -> speaker on 12 V). Never blocks loop().
//   knob (A0)          = 7 regular songs (sounds.h, role = channel), each loops seamlessly
//   speed slider (A1)  = playback speed (pitch follows, like a record player)
//   detune slider (A2) = slow random pitch drift
//   HACK button (page) = plays the next of 7 HACK songs (role = hack) once, then the regular
//                        song restarts from its beginning. Presses during a HACK song are queued.
//   UDP packet to 192.168.4.1 port 4210 = same as one HACK press (for laptop tests).
//
// Pots (Stage 1) — outer pins to 3V3 and GND (NEVER VBUS/5V: ESP32 pins are 3.3 V only):
//   A0 = knob (song / channel)   A1 = speed slide   A2 = detune slide

#include <WiFi.h>
#include <WebServer.h>
#include <WiFiUdp.h>
#include <ESPmDNS.h>
#include <DNSServer.h>
#include "sounds.h"    // song clips: GENERATED by python/convert_sounds.py, never edit by hand

static_assert(SOUND_CLIP_COUNT > 0, "sounds.h has no regular songs: sounds/clips.csv needs rows with role = channel");
static_assert(HACK_CLIP_COUNT > 0, "sounds.h has no HACK songs: sounds/clips.csv needs rows with role = hack");

// Status LED (the small yellow/orange LED_BUILTIN, D13):
//   on  = the Wi-Fi network "DFAB-ESP32" is running (normal)
//   off = the network could not be started (see Serial Monitor)
// ---- Wi-Fi (Stage 7): the ESP32's own network ----
const char* AP_SSID = "DFAB-ESP32";
// "" = open network (visitors join without a password). For a password: at least 8 characters.
const char* AP_PASSWORD = "";
// Wi-Fi channel 1, 6 or 11 (change if the room's other networks crowd channel 6)
const int AP_CHANNEL = 6;
// how many phones/laptops may be connected at once (the ESP32 allows up to 10)
const int AP_MAX_CLIENTS = 8;
const IPAddress AP_IP(192, 168, 4, 1);
// page also at http://dfab-esp32.local (laptops)
const char* HOSTNAME = "dfab-esp32";
const uint16_t UDP_PORT  = 4210;

// ---- Pots ----
const int POT_KNOB_PIN   = A0;
const int POT_SPEED_PIN  = A1;
const int POT_DETUNE_PIN = A2;
const int POT_SAMPLES    = 8;
// readings averaged per update (smoothing)
const int POT_DEADBAND   = 20;
// ignore changes smaller than this (0..4095 scale)
const int POT_SMOOTHING  = 4;
// smoothing over time: each update moves 1/4 of the way to the new reading.
// Filters Wi-Fi spikes and 3V3 dips. 1 = off, higher = calmer but slower (4 = ~0.3 s lag).
const unsigned long POT_READ_INTERVAL_MS = 20;
// read pots 50x per second
const bool PRINT_POTS    = false;
// true = print pot values 50x/s for the Serial Plotter (Stage 1 test).
// Off by default: constant USB output may disturb uploads (README §8.4).

// Current (smoothed, deadbanded) pot values, 0..4095. Later stages use these.
int knobValue   = 0;
int speedValue  = 0;
int detuneValue = 0;
unsigned long lastPotRead = 0;
// Smoothed readings (before the deadband). -1 = not started yet.
float knobFiltered   = -1;
float speedFiltered  = -1;
float detuneFiltered = -1;

// ---- Link to the R4 (Stage 2) ----
// Message format: "S<speed> W<detune>" + newline, e.g. "S1234 W2048" (both 0..4095).
// The knob (A0) is not sent: it only matters for the sound, which stays on the ESP32.
const unsigned long SEND_MIN_INTERVAL_MS = 50;    // at most 20 messages per second
const unsigned long KEEPALIVE_MS         = 500;   // resend even without change (R4 failsafe)
int lastSpeedSent  = -1;     // -1 = nothing sent yet, so the first update is always sent
int lastDetuneSent = -1;
unsigned long lastPotSend = 0;

// ---- Sound ----
// ESP32 pin -> R1 100 ohm -> MOSFET gate
const int SPEAKER_PIN = D3;
// LEDC = the ESP32's PWM hardware; channel 0 is free in this sketch
const int SPEAKER_CHANNEL = 0;
// PWM carrier frequency: far above hearing, the speaker coil smooths it out
const uint32_t AUDIO_PWM_HZ = 40000;
// false = mute (e.g. while testing other things)
const bool SOUND_ON = true;
// Playback speed from the speed slider: exponential, so every bit of slider travel changes it
// by the same percentage. Slider bottom = x TEMPO_MIN, top = x TEMPO_MAX,
// middle = x sqrt(TEMPO_MIN * TEMPO_MAX)  (keep TEMPO_MAX = 1 / TEMPO_MIN for middle = x1.00).
// x1.5 = 1.5x faster and 1.5x higher.
const float TEMPO_MIN = 0.67;
const float TEMPO_MAX = 1.5;
// Detune from the detune slider: slow random pitch drift, 0 at the bottom up to this many
// cents at the top (100 cents = 1 semitone)
const float DETUNE_MAX_CENTS = 200;
// every WARBLE_MS a new random pitch is chosen and the sound glides to it
const unsigned long WARBLE_MS = 500;
// silence (MOSFET off) before a regular song starts again.
// 0 = no pause: songs loop seamlessly (the timer interrupt jumps back to the start).
const unsigned long REPEAT_PAUSE_MS = 0;
// the knob must move this far past a zone border before the song changes (no flicker)
const int KNOB_HYSTERESIS = 60;
// knob zones = regular songs (row order of sounds/clips.csv, role = channel)
const int ZONE_COUNT = SOUND_CLIP_COUNT;

// ---- HACK button ----
// presses within this time after the last accepted press are ignored (one visitor can't zap
// through all songs in seconds)
const unsigned long HACK_LOCK_MS = 2000;
// presses waiting while a HACK song plays; more than this are dropped
const int MAX_QUEUED_HACKS = 10;

// -- clip player state. The timer interrupt (onAudioTick) reads these 8000 times per second.
// Positions use 12 fraction bits (4096 = 1 sample) so the playback speed can be any value.
hw_timer_t* audioTimer = nullptr;
const uint8_t* volatile clipData = nullptr;
volatile uint32_t clipLengthFx = 0;     // clip length in samples x 4096
volatile uint32_t clipPosFx    = 0;     // read position x 4096
volatile uint32_t clipStepFx   = 4096;  // samples per tick x 4096 (4096 = normal speed)
volatile bool clipPlaying  = false;
volatile bool clipFinished = false;
volatile bool clipLoop     = false;   // true = jump back to the start instead of ending
float warbleFrom = 0, warbleTo = 0;     // drift glides from -> to (-1 .. +1)
unsigned long warbleStart = 0;

// -- what is playing
int zone = -1;                    // knob zone = regular song, -1 = not decided yet
bool inRepeatPause = false;
unsigned long pauseStart = 0;
bool hacking = false;             // a HACK song is playing
int hackPlaying = -1;             // index in HACK_CLIPS of the song playing now, -1 = none
int hackNext = 0;                 // index of the next HACK song (wraps after the last one)
int queuedHacks = 0;              // accepted presses still waiting for their song
bool hackPressedOnce = false;     // false until the first accepted press (no lock at start)
unsigned long lastHackPress = 0;

WebServer server(80);
// answers every name lookup with 192.168.4.1, so phones show the page as a pop-up
DNSServer dnsServer;
WiFiUDP   udp;
char      packet[128];

// Start the ESP32's own Wi-Fi network (takes well under a second, nothing waits for clients)
void startNetwork() {
  WiFi.mode(WIFI_AP);
  WiFi.softAPConfig(AP_IP, AP_IP, IPAddress(255, 255, 255, 0));
  bool usePassword = strlen(AP_PASSWORD) >= 8;
  if (strlen(AP_PASSWORD) > 0 && !usePassword && Serial) {
    Serial.println("AP_PASSWORD shorter than 8 characters -> network stays OPEN");
  }
  bool ok = WiFi.softAP(AP_SSID, usePassword ? AP_PASSWORD : NULL, AP_CHANNEL, 0, AP_MAX_CLIENTS);
  digitalWrite(LED_BUILTIN, ok ? HIGH : LOW);
  // Captive portal: every name a phone looks up (e.g. connectivitycheck.gstatic.com)
  // gets the ESP32's address, so the phone's "is there internet?" check lands on our page.
  dnsServer.start(53, "*", AP_IP);
  if (MDNS.begin(HOSTNAME)) MDNS.addService("http", "tcp", 80);
  if (Serial) {
    Serial.print(ok ? "Wi-Fi network started: " : "Wi-Fi network FAILED: ");
    Serial.print(AP_SSID);
    Serial.println(usePassword ? " (password)" : " (open)");
  }
}

// Average several readings of one pot (removes most of the ADC noise)
int readPot(int pin) {
  long sum = 0;
  for (int i = 0; i < POT_SAMPLES; i++) sum += analogRead(pin);
  return sum / POT_SAMPLES;
}

// Smoothing over time (exponential moving average): moves 1/POT_SMOOTHING of the way
// toward the new reading on each update, so single spikes are mostly ignored.
int smoothPot(int raw, float& filtered) {
  if (filtered < 0) filtered = raw;    // first reading: start there, not at 0
  filtered += (raw - filtered) / POT_SMOOTHING;
  return (int)(filtered + 0.5f);
}

// Deadband: keep the old value unless the pot really moved.
// Values near the ends snap to 0 / 4095 so the full range is always reachable.
int applyDeadband(int newValue, int oldValue) {
  if (newValue <= POT_DEADBAND)        newValue = 0;
  if (newValue >= 4095 - POT_DEADBAND) newValue = 4095;
  if (abs(newValue - oldValue) >= POT_DEADBAND || newValue == 0 || newValue == 4095) {
    return newValue;
  }
  return oldValue;
}

void updatePots() {
  knobValue   = applyDeadband(smoothPot(readPot(POT_KNOB_PIN),   knobFiltered),   knobValue);
  speedValue  = applyDeadband(smoothPot(readPot(POT_SPEED_PIN),  speedFiltered),  speedValue);
  detuneValue = applyDeadband(smoothPot(readPot(POT_DETUNE_PIN), detuneFiltered), detuneValue);

  // if (PRINT_POTS && Serial) {
  //   // "label:value" pairs = one line per sample in the Arduino IDE 2 Serial Plotter
  //   Serial.print("knob:");    Serial.print(knobValue);
  //   Serial.print(" speed:");  Serial.print(speedValue);
  //   Serial.print(" detune:"); Serial.println(detuneValue);
  // }
}

// Send the slider values to the R4 when they changed (max 20/s),
// and at least every 500 ms as a keep-alive so the R4 knows the link is alive.
void sendPotsIfNeeded() {
  unsigned long sinceLast = millis() - lastPotSend;
  bool changed = (speedValue != lastSpeedSent) || (detuneValue != lastDetuneSent);

  if ((changed && sinceLast >= SEND_MIN_INTERVAL_MS) || sinceLast >= KEEPALIVE_MS) {
    Serial1.print("S");
    Serial1.print(speedValue);
    Serial1.print(" W");
    Serial1.println(detuneValue);
    lastSpeedSent  = speedValue;
    lastDetuneSent = detuneValue;
    lastPotSend    = millis();
    // Not printed to USB on purpose: it would mix into the Serial Plotter output.
  }
}

// ---------- clip player ----------

// Speed slider -> tempo factor (exponential)
float tempoFactor() {
  float t = speedValue / 4095.0f;
  return TEMPO_MIN * powf(TEMPO_MAX / TEMPO_MIN, t);
}

// Timer interrupt, 8000x per second: one sample -> PWM duty (0..255, 128 = silence level).
// Linear interpolation between samples, because at other speeds the read position falls between them.
void IRAM_ATTR onAudioTick() {
  if (!clipPlaying) return;
  uint32_t pos = clipPosFx;
  uint32_t i = pos >> 12;
  uint32_t frac = pos & 4095;
  uint32_t len = clipLengthFx >> 12;
  const uint8_t* d = clipData;
  int a = d[i];
  int b = (i + 1 < len) ? d[i + 1] : 128;
  ledcWrite(SPEAKER_CHANNEL, a + (((b - a) * (int)frac) >> 12));
  pos += clipStepFx;
  if (pos >= clipLengthFx) {
    if (clipLoop) {
      pos -= clipLengthFx;                // seamless loop: no gap, no click
    } else {
      clipPlaying = false;
      clipFinished = true;
      ledcWrite(SPEAKER_CHANNEL, 0);      // end of clip: 0 % duty = MOSFET off
    }
  }
  clipPosFx = pos;
}

void stopClip() {
  clipPlaying = false;                    // the interrupt does nothing from now on
  clipFinished = false;
  ledcWrite(SPEAKER_CHANNEL, 0);
}

// Playback speed = tempo x slow random drift (both live)
void updateClipRate() {
  unsigned long now = millis();
  // where the glide is now (capped at its end, so a slow loop or a pause never overshoots)
  float t = (now - warbleStart) / (float)WARBLE_MS;
  if (t > 1.0f) t = 1.0f;
  float drift = warbleFrom + (warbleTo - warbleFrom) * t;
  if (now - warbleStart >= WARBLE_MS) {
    // next glide starts exactly where the sound is now: no jumps
    warbleFrom = drift;
    warbleTo = random(-1000, 1001) / 1000.0f;
    warbleStart = now;
  }
  float cents = drift * DETUNE_MAX_CENTS * (detuneValue / 4095.0f);
  float rate = tempoFactor() * powf(2.0f, cents / 1200.0f);
  clipStepFx = (uint32_t)(rate * 4096.0f + 0.5f);
}

// Start a clip from its beginning. loop = true: repeat seamlessly; false: play once.
void startClip(const SoundClip& clip, bool loop) {
  stopClip();
  clipData = clip.variants[0].data;
  clipLengthFx = clip.variants[0].length << 12;
  clipPosFx = 0;
  clipLoop = loop;
  updateClipRate();
  if (SOUND_ON) clipPlaying = true;
  else clipFinished = true;               // muted: behave as if the clip ended at once
}

// ---------- what plays when ----------

// Knob -> zone, with hysteresis so it doesn't flicker at a zone border
int knobZone() {
  int zoneWidth = 4096 / ZONE_COUNT;
  if (zone >= 0) {
    int center = zone * zoneWidth + zoneWidth / 2;
    if (abs(knobValue - center) <= zoneWidth / 2 + KNOB_HYSTERESIS) return zone;
  }
  int z = knobValue / zoneWidth;
  if (z >= ZONE_COUNT) z = ZONE_COUNT - 1;
  return z;
}

// Start the knob's regular song from its beginning
void startZoneSound() {
  inRepeatPause = false;
  startClip(SOUND_CLIPS[zone], REPEAT_PAUSE_MS == 0);
}

// Start the next HACK song (the list wraps around after the last one)
void startNextHack() {
  hackPlaying = hackNext;
  hackNext = (hackNext + 1) % HACK_CLIP_COUNT;
  startClip(HACK_CLIPS[hackPlaying], false);
  if (Serial) { Serial.print("HACK: "); Serial.println(HACK_CLIPS[hackPlaying].name); }
}

// One press of the HACK button (or one UDP packet).
// Returns 0 = accepted, 1 = ignored (within HACK_LOCK_MS of the last press), 2 = queue full.
int pressHack() {
  unsigned long now = millis();
  if (hackPressedOnce && now - lastHackPress < HACK_LOCK_MS) return 1;
  hackPressedOnce = true;
  lastHackPress = now;
  if (queuedHacks >= MAX_QUEUED_HACKS) return 2;
  queuedHacks++;
  return 0;
}

// Call as often as possible from loop()
void updateSound() {
  unsigned long now = millis();

  // Knob moved to another regular song
  int z = knobZone();
  if (z != zone) {
    zone = z;
    if (Serial) { Serial.print("song: "); Serial.println(SOUND_CLIPS[zone].name); }
    // during a HACK song the new regular song starts afterwards
    if (!hacking) startZoneSound();
  }

  // A press is waiting: interrupt with the next HACK song
  if (!hacking && queuedHacks > 0) {
    queuedHacks--;
    hacking = true;
    startNextHack();
    return;
  }

  // speed + drift apply to every song, HACK songs included
  updateClipRate();

  if (hacking) {
    if (clipFinished) {
      clipFinished = false;
      if (queuedHacks > 0) {
        queuedHacks--;                    // next queued press: next HACK song
        startNextHack();
      } else {
        hacking = false;
        hackPlaying = -1;
        startZoneSound();                 // the regular song restarts from its beginning
      }
    }
    return;
  }

  // Regular song: loops seamlessly (REPEAT_PAUSE_MS = 0) or pauses before repeating
  if (inRepeatPause) {
    // signed comparison: with REPEAT_PAUSE_MS = 0 this is simply true at once
    if ((long)(now - pauseStart) >= (long)REPEAT_PAUSE_MS) startZoneSound();
    return;
  }
  if (clipFinished) {
    clipFinished = false;
    inRepeatPause = true;
    pauseStart = now;
  }
}

// ---------- web page ----------

// Make text safe to show inside the web page
String htmlEscape(String s) {
  s.replace("&", "&amp;");
  s.replace("<", "&lt;");
  s.replace(">", "&gt;");
  return s;
}

// What is playing now, as one line of text (page + /status)
String nowPlaying() {
  if (hacking && hackPlaying >= 0) {
    String s = "HACK: " + String(HACK_CLIPS[hackPlaying].name);
    if (queuedHacks > 0) s += " (+" + String(queuedHacks) + " waiting)";
    return s;
  }
  if (zone >= 0) return "Playing: " + String(SOUND_CLIPS[zone].name);
  return "";
}

void handleRoot() {
  String note = "";
  if (server.arg("m") == "wait") note = "Wait a moment&hellip;";
  if (server.arg("m") == "full") note = "Too many hacks waiting.";
  String html =
    "<!DOCTYPE html><html><head><meta charset='utf-8'>"
    "<meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<title>HACK</title><style>"
    "body{font-family:sans-serif;text-align:center;margin:24px;background:#111;color:#eee}"
    "button{display:block;margin:32px auto;width:220px;height:220px;border-radius:50%;border:none;"
    "background:#d00000;color:#fff;font-size:44px;font-weight:bold;letter-spacing:4px;"
    "box-shadow:0 8px 0 #7a0000;cursor:pointer}"
    "button:active{transform:translateY(6px);box-shadow:0 2px 0 #7a0000}"
    "#s{font-size:20px;min-height:1.5em}.n{color:#f88;min-height:1.2em}"
    "</style></head><body>"
    "<form action='/hack' method='post'><button>HACK</button></form>"
    "<p class='n'>" + note + "</p>"
    "<p id='s'>" + htmlEscape(nowPlaying()) + "</p>"
    // update the song name every 2 s without reloading the page
    "<script>setInterval(function(){fetch('/status').then(function(r){return r.text()})"
    ".then(function(t){document.getElementById('s').textContent=t}).catch(function(){})},2000)</script>"
    "</body></html>";
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "text/html", html);
}

// The button sends a POST to /hack; afterwards the browser goes back to the page
// (so reloading the page never presses the button again).
void handleHack() {
  int result = pressHack();
  if (Serial) Serial.println(result == 0 ? "HACK pressed" : (result == 1 ? "HACK ignored (lock)" : "HACK ignored (queue full)"));
  server.sendHeader("Location", result == 0 ? "/" : (result == 1 ? "/?m=wait" : "/?m=full"));
  server.send(303);
}

void handleStatus() {
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "text/plain", nowPlaying());
}

// Any other address (the phones' internet checks, e.g. /generate_204 or /hotspot-detect.html):
// send them to the page. This is what makes the "Sign in to network" pop-up appear.
void handleCaptive() {
  server.sendHeader("Location", "http://192.168.4.1/", true);
  server.send(302, "text/plain", "");
}

void setup() {
  // Very first thing: 3 quick flashes = this sketch version is running
  pinMode(LED_BUILTIN, OUTPUT);
  for (int i = 0; i < 3; i++) {
    digitalWrite(LED_BUILTIN, HIGH); delay(150);
    digitalWrite(LED_BUILTIN, LOW);  delay(150);
  }

  Serial.begin(115200);                      // USB: debug only
  Serial1.begin(9600, SERIAL_8N1, D9, D8);   // RX = D9 (GPIO18), TX = D8 (GPIO17)

  // Speaker PWM: 40 kHz, 8 bit (duty 0..255 = one sample); start at 0 % = MOSFET off
  ledcSetup(SPEAKER_CHANNEL, AUDIO_PWM_HZ, 8);
  ledcAttachPin(SPEAKER_PIN, SPEAKER_CHANNEL);
  ledcWrite(SPEAKER_CHANNEL, 0);
  // Sample clock: hardware timer 0, 1 MHz ticks (80 MHz / 80), interrupt every 125 us = 8 kHz
  audioTimer = timerBegin(0, 80, true);
  timerAttachInterrupt(audioTimer, &onAudioTick, true);
  timerAlarmWrite(audioTimer, 1000000 / SOUND_SAMPLE_RATE, true);
  timerAlarmEnable(audioTimer);
  analogReadResolution(12);                  // pots read 0..4095
  delay(1500);                               // time to open the Serial Monitor
  if (Serial) Serial.println("esp32_wifi_to_r4 starting (own Wi-Fi + 7 songs + HACK button)");

  startNetwork();

  server.on("/", handleRoot);
  server.on("/hack", HTTP_POST, handleHack);
  server.on("/status", handleStatus);
  server.onNotFound(handleCaptive);
  server.begin();
  udp.begin(UDP_PORT);

  if (Serial) Serial.println("Join the Wi-Fi DFAB-ESP32, then open http://192.168.4.1");
}

void loop() {
  dnsServer.processNextRequest();
  server.handleClient();

  // Read the pots on a timer (no delay(), so Wi-Fi and the web page stay responsive)
  if (millis() - lastPotRead >= POT_READ_INTERVAL_MS) {
    lastPotRead = millis();
    updatePots();
    sendPotsIfNeeded();
  }

  updateSound();

  // Any UDP packet = one HACK press (laptop tests); its content is ignored
  if (udp.parsePacket() > 0) {
    udp.read(packet, sizeof(packet));
    pressHack();
  }
}
